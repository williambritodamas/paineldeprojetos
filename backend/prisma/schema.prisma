// Definição de dados do banco SQLite via Prisma ORM.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Usuário do sistema.
// O papel (role) define o nível de acesso: "admin" ou "user".
model User {
  id        Int      @id @default(autoincrement())
  name      String
  username  String   @unique
  password  String
  role      String   @default("user")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Projeto que roda em uma porta específica.
// O host (localhost/IP/hostname) é montado dinamicamente no frontend.
// Os campos de execução (folderPath/script/autostart/pm2Name) referem-se ao
// processo principal; processos adicionais ficam em ProjectProcess.
model Project {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  icon        String?
  port        Int
  active      Boolean  @default(true)
  // Ambiente do projeto: "desenvolvimento", "homologacao" ou "producao".
  environment String?
  // Caminho da pasta no servidor (usado para gerenciar via PM2).
  folderPath  String?
  // Comando executado pelo PM2 na pasta do projeto (ex.: "npm start").
  script      String   @default("npm start")
  // Se o projeto deve ser registrado no PM2 para iniciar no boot.
  autostart   Boolean  @default(false)
  // Nome opcional do processo no PM2. Se vazio, usa "proj-<id>".
  pm2Name     String?
  // Variáveis de ambiente do processo principal (CHAVE=valor por linha).
  env            String?
  // Reinicia o processo automaticamente se ele cair.
  autorestart    Boolean  @default(true)
  // Atraso em ms entre reinícios automáticos.
  restartDelay   Int      @default(1000)
  // Limite de reinícios antes de marcar o processo como "errored".
  maxRestarts    Int      @default(10)
  // Limite de memória que dispara reinício quando estourado (ex.: "512M").
  maxMemoryRestart String?
  // Categoria do projeto (opcional).
  categoryId     Int?
  category       Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  // Servidor do projeto (opcional).
  serverId       Int?
  server         Server?   @relation(fields: [serverId], references: [id], onDelete: SetNull)
  // Processos adicionais executados junto com o projeto (ex.: backend).
  processes   ProjectProcess[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Processo adicional de um projeto.
// Cada processo roda numa porta e pasta próprias e é gerenciado pelo PM2
// junto com o processo principal do projeto.
model ProjectProcess {
  id         Int      @id @default(autoincrement())
  projectId  Int
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Nome descritivo do processo (ex.: "Frontend", "Backend").
  label      String
  // Caminho da pasta no servidor onde o processo é executado.
  folderPath String
  // Comando executado pelo PM2 na pasta do processo (ex.: "npm start").
  script     String   @default("npm start")
  // Porta em que o processo roda.
  port       Int
  // Variáveis de ambiente do processo (CHAVE=valor por linha).
  env            String?
  // Reinicia o processo automaticamente se ele cair.
  autorestart    Boolean  @default(true)
  // Atraso em ms entre reinícios automáticos.
  restartDelay   Int      @default(1000)
  // Limite de reinícios antes de marcar o processo como "errored".
  maxRestarts    Int      @default(10)
  // Limite de memória que dispara reinício quando estourado (ex.: "512M").
  maxMemoryRestart String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Categoria do projeto (ex.: Educação, Audiovisual, Sistemas).
model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // Relação: uma categoria pode ter vários projetos.
  projects  Project[]
}

// Servidor onde o projeto está hospedado (ex.: Local, Escola, Cloud).
model Server {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  host        String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  // Relação: um servidor pode ter vários projetos.
  projects    Project[]
}
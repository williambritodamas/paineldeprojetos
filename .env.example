# ===========================
# BACKEND
# ===========================

# Porta do servidor da API
PORT=3000

# String de conexão com o banco SQLite
DATABASE_URL="file:./dev.db"

# Endereço do frontend permitido no CORS
FRONTEND_URL="http://localhost:5173"

# Chave secreta utilizada para assinar o JWT
JWT_SECRET="alterar_esta_chave"

# Usuário administrador inicial criado pelo seed
ADMIN_NAME="Administrador"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="alterar_esta_senha"

# Informações exibidas no rodapé
AUTOR_SISTEMA="Nome do Desenvolvedor"
GESTOR_SETOR="Nome do Gestor"

# ===========================
# FRONTEND
# ===========================

# Endereço da API utilizado pelo frontend
VITE_API_URL="http://localhost:3000/api"